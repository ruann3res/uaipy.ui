  "endpoints": {
    "authentication": [
      {
        "method": "POST",
        "path": "/auth/register",
        "description": "Registrar novo usuário",
        "service": "AuthService",
        "function": "signUp",
        "content_type": "application/json"
      },
      {
        "method": "POST", 
        "path": "/auth/token",
        "description": "Autenticar usuário e obter token",
        "service": "AuthService",
        "function": "signIn",
        "content_type": "application/x-www-form-urlencoded"
      }
    ],
    "projects": [
      {
        "method": "GET",
        "path": "/projects",
        "description": "Listar todos os projetos",
        "service": "ProjectService",
        "function": "get"
      },
      {
        "method": "POST",
        "path": "/projects",
        "description": "Criar novo projeto", 
        "service": "ProjectService",
        "function": "create"
      },
      {
        "method": "GET",
        "path": "/projects/{id}",
        "description": "Obter projeto por ID",
        "service": "ProjectService", 
        "function": "getById"
      },
      {
        "method": "PUT",
        "path": "/projects/{id}",
        "description": "Atualizar projeto existente",
        "service": "ProjectService",
        "function": "update"
      },
      {
        "method": "DELETE",
        "path": "/projects/{id}",
        "description": "Excluir projeto",
        "service": "ProjectService",
        "function": "delete"
      }
    ],
